# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env & secrets — never commit real credentials
.env
.env.*
!.env.example
!.env*.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
deploy/.env.production
!.env.example

# DB dumps / backups
*.sql
*.dump
*.sqlite3
*.bak
*.db-journal

# private / internal APIs (do not publish)
private/
**/private-api/
**/private-apis/
secrets/
*.secret.json
*.secrets.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
backend/data/
/data/
*.db

# =============================================================================
# Dev / runtime generated (Cursor + disk hygiene) — do not track
# =============================================================================

# Python virtualenvs
.venv/
venv/
env/
backend/.venv/

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.turbo/
.cache/
*.cache

# Logs & temp
logs/
tmp/
temp/
*.log

# Runtime uploads / artifacts
uploads/
storage/
artifacts/
screenshots/
test-results/
playwright-report/

# Local docker / DB volume mounts (if present on host)
docker-data/
mysql-data/
redis-data/
milvus-data/
volumes/

# Backend local data already partially covered; keep explicit
backend/.venv/
backend/**/__pycache__/

# OS / IDE
.idea/
.vscode/
Thumbs.db