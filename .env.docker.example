# Copy to .env.docker for Docker Compose
NOVAFLOW_ADMIN_PASSWORD=change-me-min-16-chars
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ALLOW_PASSWORD_LOGIN=1
GMAIL_ONLY_AUTH=0
STRICT_SECURITY_MODE=0
ENFORCE_GMAIL_ONLY=0
REQUIRE_USER_API_KEYS=0
USER_API_KEY_REQUIRED=0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
JWT_SECRET=novaflow-local-dev-secret-change-before-prod
