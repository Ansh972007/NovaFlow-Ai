# NovaFlow AI — copy to .env.local for local dev, or .env for Docker Compose

# NovaFlow API (local backend default)
NEXT_PUBLIC_API_URL=http://localhost:3001

# App metadata
NEXT_PUBLIC_APP_NAME=NovaFlow AI

# Universal AI Chat System
NEXT_PUBLIC_UNIVERSAL_CHAT_ENABLED=true

# --- Docker ---
#   Full stack:  .\scripts\full-stack-up.ps1
#   Low RAM:     .\scripts\cursor-stack-build.ps1
#   Login: admin / NovaFlowLocalDevAdmin1
# OPENAI_API_KEY=sk-or-v1-...   # or set per-user in Settings → API Keys
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret
# OAUTH_REDIRECT_BASE=http://localhost:3001
# FRONTEND_URL=http://localhost:3000
# ALLOW_PASSWORD_LOGIN=0
