# ==============================================================================
# NOVAFLOW AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   - .env.local (for local Next.js frontend development)
#   - .env (for Docker Compose or local FastAPI backend)
#   - Configure in Vercel Environment Variables (Frontend)
#   - Configure in Render Environment Variables (Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Next.js)
# ------------------------------------------------------------------------------
# In Local Dev: http://localhost:3001
# In Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Explicit WebSocket URL override (defaults to wss:// derived from NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com

# Brand / App Name
NEXT_PUBLIC_APP_NAME=NovaFlow AI
NEXT_PUBLIC_UNIVERSAL_CHAT_ENABLED=true

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / FastAPI / Local)
# ------------------------------------------------------------------------------
NOVAFLOW_ENV=development
# Render automatically injects PORT. For local dev: 3001
NOVAFLOW_PORT=3001

# Relational Database:
#   - Local Dev: sqlite:///data/novaflow.db or mysql+pymysql://root:root@localhost:3306/novaflow
#   - Production (Supabase): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///data/novaflow.db

# Redis Cache & Presence:
#   - Local Dev: redis://localhost:6379/0 (or leave empty for memory cache)
#   - Production (Upstash): rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL=

# Vector Storage:
#   - Local Dev: Leave empty (uses internal In-Memory / SQLite cosine search) or Milvus
#   - Production: milvus uri or Leave empty to use auto-fallback vector engine
MILVUS_URI=

# Security & Encryption:
#   - JWT Secret: 64-character high-entropy hex or random string
#   - Encryption Key: Base64 AES-256 master key for Credential Vault
JWT_SECRET=novaflow-dev-secret-change-in-prod-must-be-secure
ENCRYPTION_KEY=

# Public Frontend & API URLs (CORS & Webhooks):
#   - Set FRONTEND_URL to your Vercel URL in production (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:3000
# Optional: Allowed CORS origins (comma-separated). Automatically includes FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public API Base for Telegram/Slack Webhooks & OAuth Callbacks:
#   - On Render: Automatically resolved from RENDER_EXTERNAL_URL if empty
#   - With Ngrok: https://your-tunnel.ngrok-free.dev
PUBLIC_BASE_URL=

# Authentication Controls:
ALLOW_PASSWORD_LOGIN=1
ALLOW_PUBLIC_REGISTER=1
GMAIL_ONLY_AUTH=0

# Admin Bootstrap Credentials:
NOVAFLOW_ADMIN_USER=admin
NOVAFLOW_ADMIN_PASSWORD=NovaFlowLocalDevAdmin1

# ------------------------------------------------------------------------------
# 3. OPTIONAL INTEGRATIONS & THIRD-PARTY PROVIDERS
# ------------------------------------------------------------------------------
# Default Fallback LLM Provider (Can also be configured per-user in UI):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google OAuth 2.0 (SSO & Gmail Integration):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Bot Token (Can also be set in UI Credentials Vault):
TELEGRAM_BOT_TOKEN=
