# NovaFlow API — copy to backend/.env or set in docker-compose

NOVAFLOW_PORT=3001
NOVAFLOW_ENV=development
# Primary target: PostgreSQL 17+ (SQLite/MySQL remain compatible for local/legacy)
# DATABASE_URL=postgresql+psycopg://novaflow:novaflow@127.0.0.1:5433/novaflow
# DATABASE_URL=postgresql+psycopg://novaflow:novaflow@127.0.0.1:6432/novaflow  # via PgBouncer
DATABASE_URL=mysql+pymysql://novaflow:novaflow@localhost:3307/novaflow
REDIS_URL=redis://localhost:6381/0
DB_PGBOUNCER_MODE=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000
DB_PARTITION_MONTHS_AHEAD=3
VECTOR_PROVIDER=auto
# QDRANT_URL=
# QDRANT_API_KEY=
STORAGE_PROVIDER=local
# STORAGE_BUCKET=novaflow
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=auto
AUDIT_RETENTION_DAYS=365
SOFT_DELETE_PURGE_DAYS=90
# REQUIRED in production — ≥32 random bytes. Weak defaults refuse to boot when NOVAFLOW_ENV=production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAX_SESSIONS_PER_USER=10
PASSWORD_PEPPER=
PASSWORD_MIN_LENGTH=8
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MAX_UPLOAD_BYTES=26214400
SSRF_ALLOW_PRIVATE=0
DATA_DIR=./data

# Optional — real LLM replies (OpenAI or OpenRouter)
# OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OpenRouter (sk-or-v1-...):
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# First admin (required when users table is empty; ≥16 chars, not a known default)
NOVAFLOW_ADMIN_USER=admin
NOVAFLOW_ADMIN_PASSWORD=
NOVAFLOW_VAULT_KEY=
ALLOW_PUBLIC_REGISTER=0
NOVAFLOW_ENV=development

# Set to 1 to seed demo assistants + handbook on first boot
NOVAFLOW_DEMO_SEED=0

# OAuth / SSO (optional — buttons appear on login when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# LDAP directory login (optional)
LDAP_URL=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# SAML 2.0 SSO (optional — SAML button on login when IdP URL is set)
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_SP_ENTITY_ID=novaflow-ai
SAML_IDP_CERT=

# Platform mail (password reset + team invites). Password is server-side only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
