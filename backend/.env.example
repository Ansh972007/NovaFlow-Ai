# NovaFlow API — copy to backend/.env or set in docker-compose

NOVAFLOW_PORT=3001
DATABASE_URL=mysql+pymysql://novaflow:novaflow@localhost:3307/novaflow
REDIS_URL=redis://localhost:6381/0
JWT_SECRET=change-me-in-production
DATA_DIR=./data

# Optional — real LLM replies (or add providers in Settings → Model providers vault)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Default admin (created on first boot if no users)
NOVAFLOW_ADMIN_USER=admin
NOVAFLOW_ADMIN_PASSWORD=admin123

# Set to 1 to seed demo assistants + handbook on first boot
NOVAFLOW_DEMO_SEED=0

# OAuth / SSO (optional — buttons appear on login when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# LDAP directory login (optional)
LDAP_URL=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# SAML 2.0 SSO (optional — SAML button on login when IdP URL is set)
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_SP_ENTITY_ID=novaflow-ai
SAML_IDP_CERT=
