# Optional Docker Compose overrides — copy to .env in project root
# docker compose automatically loads .env from the project directory

NOVAFLOW_ENV=development
NOVAFLOW_ADMIN_PASSWORD=NovaFlowLocalDevAdmin1
JWT_SECRET=novaflow-local-dev-secret-change-before-prod
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:3001
ALLOW_PASSWORD_LOGIN=1

# ngrok — one-time: ngrok config add-authtoken YOUR_TOKEN
# Or set NGROK_AUTHTOKEN here; scripts/start-with-ngrok.* reads it and writes NOVAFLOW_PUBLIC_BASE_URL
# NGROK_AUTHTOKEN=
# NOVAFLOW_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Optional LLM keys (or set per-user in Settings → API Keys)
# OPENAI_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEY=sk-or-v1-...
