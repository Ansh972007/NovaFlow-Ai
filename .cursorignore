# =============================================================================
# NovaFlow — Cursor indexing exclusions (dev workspace OOM protection)
# Keep ONLY source, configs, and docs indexable. Exclude generated / binary /
# dependency / runtime data that inflates RAM on 16 GB machines.
# =============================================================================

# --- Dependencies ---
node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Python environments & bytecode ---
.venv/
venv/
env/
**/Lib/site-packages/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Next.js / frontend build & caches ---
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Test / coverage / type caches ---
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.htmlcov/
.hypothesis/
*.cover
.coverage
.coverage.*

# --- Logs, temp, cache ---
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
temp/
.tmp/
.temp/
cache/
.cache/
**/cache/
*.cache

# --- Uploads, storage, runtime artifacts ---
uploads/
**/uploads/
storage/
**/storage/
artifacts/
**/artifacts/
media/
**/media/
screenshots/
**/screenshots/
test-results/
playwright-report/
blob-report/

# --- Local / docker volume data (never index) ---
data/
**/data/mysql/
**/data/redis/
**/data/milvus/
**/data/etcd/
**/data/minio/
docker-data/
mysql-data/
redis-data/
milvus-data/
volumes/
.docker/

# --- Vector DB / embeddings dumps ---
**/vectors/
**/*.faiss
**/*.index
**/chroma/
**/chromadb/
**/qdrant/
**/milvus/

# --- Binary / media assets (not useful for code search) ---
*.glb
*.gltf
*.bin
*.wasm
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.ogg
*.flac
*.psd
*.ai
*.sketch
*.fig
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.dmg
*.exe
*.dll
*.dylib
*.node
*.parquet
*.arrow
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.safetensors
*.gguf
*.ggml

# --- IDE / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Secrets (never index) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
**/*.secret.json
**/*.secrets.json

# --- Vercel / deploy caches ---
.vercel/
.netlify/

# --- Git internals ---
.git/