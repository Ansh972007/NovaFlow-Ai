# NovaFlow production environment — copy to deploy/.env.production
# Required before running start-prod.ps1 or start-demo.ps1

# --- Security (change these before real production!) ---
JWT_SECRET=novaflow-dev-jwt-change-me-in-production
NOVAFLOW_ADMIN_PASSWORD=admin123

# --- Public URLs (browser must reach the API) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=NovaFlow AI
WEB_PORT=3000

# --- Database ---
MYSQL_ROOT_PASSWORD=novaflow
MYSQL_DATABASE=novaflow
MYSQL_USER=novaflow
MYSQL_PASSWORD=novaflow

# --- Admin account (created on first boot) ---
NOVAFLOW_ADMIN_USER=admin

# --- Demo mode: seed sample assistants + knowledge on first boot ---
NOVAFLOW_DEMO_SEED=0

# --- Optional: real LLM responses ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
